import { MODERN_ENGINE_URL } from "./stockfishEngine";

export type EngineSource = "browser" | "local_ws";

export interface EngineSettings {
  source: EngineSource;
  wsUrl: string; // e.g. "ws://localhost:8080"
  threads: number;
  hashMb: number;
  multiPv: number;
  infinite: boolean;
}

export const DEFAULT_ENGINE_SETTINGS: EngineSettings = {
  source: "browser",
  wsUrl: "ws://localhost:8080",
  threads: 4,
  hashMb: 256,
  multiPv: 3,
  infinite: true,
};

const SETTINGS_KEY = "hybrid_analysis_engine_settings_v1";

export function loadEngineSettings(): EngineSettings {
  try {
    const raw = localStorage.getItem(SETTINGS_KEY);
    if (raw) return { ...DEFAULT_ENGINE_SETTINGS, ...JSON.parse(raw) };
  } catch {}
  return DEFAULT_ENGINE_SETTINGS;
}

export function saveEngineSettings(s: EngineSettings) {
  try {
    localStorage.setItem(SETTINGS_KEY, JSON.stringify(s));
  } catch {}
}

export interface PvLine {
  multipv: number;
  depth: number;
  scoreCp: number | null;
  scoreMate: number | null;
  nodes: number;
  nps: number;
  pv: string[]; // UCI moves, e.g. ["d2d4", "d7d5", "c2c4"]
  pvSan?: string[];
}

export interface EngineAnalysisState {
  isAnalyzing: boolean;
  engineName: string;
  source: EngineSource;
  wsConnected: boolean;
  depth: number;
  nps: number;
  nodes: number;
  lines: PvLine[];
}

export type AnalysisCallback = (state: EngineAnalysisState) => void;

class HybridAnalysisEngine {
  private worker: Worker | null = null;
  private ws: WebSocket | null = null;
  private settings: EngineSettings = loadEngineSettings();
  private callbacks = new Set<AnalysisCallback>();
  private currentFen = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";

  private state: EngineAnalysisState = {
    isAnalyzing: false,
    engineName: "Stockfish 19 Lite",
    source: "browser",
    wsConnected: false,
    depth: 0,
    nps: 0,
    nodes: 0,
    lines: [],
  };

  constructor() {
    this.init();
  }

  public getSettings(): EngineSettings {
    return { ...this.settings };
  }

  public updateSettings(newSettings: Partial<EngineSettings>) {
    const prevSource = this.settings.source;
    const prevWsUrl = this.settings.wsUrl;
    this.settings = { ...this.settings, ...newSettings };
    saveEngineSettings(this.settings);

    if (newSettings.source && newSettings.source !== prevSource) {
      this.init();
      return;
    }

    if (this.settings.source === "local_ws" && newSettings.wsUrl && newSettings.wsUrl !== prevWsUrl) {
      this.initLocalWs();
      return;
    }

    this.applyEngineOptions();
    if (this.state.isAnalyzing) {
      this.restartAnalysis();
    }
  }

  public subscribe(cb: AnalysisCallback) {
    this.callbacks.add(cb);
    cb(this.state);
    return () => this.callbacks.delete(cb);
  }

  private notify() {
    this.callbacks.forEach((fn) => fn({ ...this.state }));
  }

  public init() {
    this.stop();
    this.cleanup();

    this.state.source = this.settings.source;
    if (this.settings.source === "local_ws") {
      this.initLocalWs();
    } else {
      this.initBrowserWorker();
    }
  }

  private cleanup() {
    if (this.worker) {
      this.worker.terminate();
      this.worker = null;
    }
    if (this.ws) {
      this.ws.close();
      this.ws = null;
    }
    this.state.wsConnected = false;
  }

  private initBrowserWorker() {
    this.state.engineName = "Stockfish 19 Lite (WASM)";
    this.state.wsConnected = false;
    this.notify();

    try {
      this.worker = new Worker(MODERN_ENGINE_URL);
      this.worker.onmessage = (e) => this.handleUciOutput(String(e.data));
      this.worker.onerror = () => {
        // Fallback to legacy CDN worker if local wasm is blocked
        console.warn("[AnalysisEngine] WASM failed, falling back to legacy worker");
        const stub = `importScripts("https://cdn.jsdelivr.net/npm/stockfish.js@10.0.2/stockfish.js");`;
        const fb = new Worker(URL.createObjectURL(new Blob([stub], { type: "text/javascript" })));
        fb.onmessage = (e) => this.handleUciOutput(String(e.data));
        this.worker = fb;
        this.send("uci");
      };
      this.send("uci");
    } catch {
      this.state.engineName = "Engine Offline";
      this.notify();
    }
  }

  private initLocalWs() {
    this.state.engineName = "Connecting Desktop Engine...";
    this.state.wsConnected = false;
    this.notify();

    try {
      const socket = new WebSocket(this.settings.wsUrl);
      socket.onopen = () => {
        this.state.wsConnected = true;
        this.state.engineName = "Native Stockfish 19 (Desktop)";
        this.notify();
        this.send("uci");
      };
      socket.onmessage = (e) => this.handleUciOutput(String(e.data));
      socket.onclose = () => {
        this.state.wsConnected = false;
        this.state.engineName = "Desktop Disconnected";
        this.notify();
      };
      socket.onerror = () => {
        this.state.wsConnected = false;
        this.state.engineName = "Desktop Engine Unreachable";
        this.notify();
      };
      this.ws = socket;
    } catch {
      this.state.wsConnected = false;
      this.state.engineName = "Desktop Engine Error";
      this.notify();
    }
  }

  private send(cmd: string) {
    if (this.settings.source === "local_ws") {
      if (this.ws && this.ws.readyState === WebSocket.OPEN) {
        this.ws.send(cmd + "\n");
      }
    } else {
      if (this.worker) {
        this.worker.postMessage(cmd);
      }
    }
  }

  private applyEngineOptions() {
    this.send(`setoption name MultiPV value ${this.settings.multiPv}`);
    if (this.settings.source === "local_ws") {
      this.send(`setoption name Threads value ${this.settings.threads}`);
      this.send(`setoption name Hash value ${this.settings.hashMb}`);
    } else {
      this.send(`setoption name Hash value ${Math.min(256, this.settings.hashMb)}`);
    }
    this.send("isready");
  }

  public evaluatePosition(fen: string) {
    this.currentFen = fen;
    this.state.lines = [];
    this.state.depth = 0;
    this.state.nodes = 0;
    this.state.nps = 0;
    this.notify();

    this.send("stop");
    this.applyEngineOptions();
    this.send(`position fen ${fen}`);
    if (this.settings.infinite) {
      this.send("go infinite");
    } else {
      this.send("go depth 30");
    }
    this.state.isAnalyzing = true;
    this.notify();
  }

  public restartAnalysis() {
    this.evaluatePosition(this.currentFen);
  }

  public stop() {
    this.send("stop");
    this.state.isAnalyzing = false;
    this.notify();
  }

  public toggleAnalysis() {
    if (this.state.isAnalyzing) {
      this.stop();
    } else {
      this.evaluatePosition(this.currentFen);
    }
  }

  private handleUciOutput(line: string) {
    if (line.startsWith("id name ")) {
      const name = line.replace("id name ", "").trim();
      this.state.engineName = name;
      this.notify();
      return;
    }

    if (line === "uciok") {
      this.applyEngineOptions();
      return;
    }

    if (line.startsWith("info ") && line.includes(" depth ") && line.includes(" score ")) {
      this.parseInfoLine(line);
    }
  }

  private parseInfoLine(line: string) {
    const tokens = line.split(/\s+/);
    let multipv = 1;
    let depth = this.state.depth;
    let nodes = this.state.nodes;
    let nps = this.state.nps;
    let scoreCp: number | null = null;
    let scoreMate: number | null = null;
    let pvIdx = -1;

    for (let i = 0; i < tokens.length; i++) {
      const t = tokens[i];
      if (t === "multipv" && tokens[i + 1]) multipv = parseInt(tokens[i + 1], 10);
      else if (t === "depth" && tokens[i + 1]) depth = parseInt(tokens[i + 1], 10);
      else if (t === "nodes" && tokens[i + 1]) nodes = parseInt(tokens[i + 1], 10);
      else if (t === "nps" && tokens[i + 1]) nps = parseInt(tokens[i + 1], 10);
      else if (t === "score") {
        const type = tokens[i + 1];
        const val = parseInt(tokens[i + 2], 10);
        if (type === "cp") scoreCp = val;
        else if (type === "mate") scoreMate = val;
      } else if (t === "pv") {
        pvIdx = i + 1;
        break;
      }
    }

    if (pvIdx !== -1) {
      const pv = tokens.slice(pvIdx);
      this.state.depth = Math.max(this.state.depth, depth);
      this.state.nodes = nodes;
      this.state.nps = nps;

      const existingIndex = this.state.lines.findIndex((l) => l.multipv === multipv);
      const newLine: PvLine = {
        multipv,
        depth,
        scoreCp,
        scoreMate,
        nodes,
        nps,
        pv,
      };

      if (existingIndex >= 0) {
        this.state.lines[existingIndex] = newLine;
      } else {
        this.state.lines.push(newLine);
      }
      this.state.lines.sort((a, b) => a.multipv - b.multipv);
      this.notify();
    }
  }
}

export const analysisEngine = new HybridAnalysisEngine();






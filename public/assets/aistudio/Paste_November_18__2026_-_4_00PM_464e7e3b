import type { PrivateBotProfile } from "@/lib/privateBotPlayerStore";

export function PrivateRatingModal({
  open,
  onClose,
  result,
  userProfile,
  oldRating,
  newRating,
  delta,
  opponentName,
  opponentAvatar,
  opponentOldRating,
  opponentDelta,
  onRematch,
  onNewMatch,
}: {
  open: boolean;
  onClose: () => void;
  result: "win" | "loss" | "draw";
  userProfile: PrivateBotProfile;
  oldRating: number;
  newRating: number;
  delta: number;
  opponentName: string;
  opponentAvatar?: string | null;
  opponentOldRating: number;
  opponentDelta: number;
  onRematch: () => void;
  onNewMatch: () => void;
}) {
  const [displayRating, setDisplayRating] = useState(oldRating);
  const isWin = result === "win";
  const isLoss = result === "loss";

  useEffect(() => {
    if (!open) return;
    setDisplayRating(oldRating);

    // Smooth counting interpolation over 1.2s
    const startTime = performance.now();
    const duration = 1200;

    const frame = (now: number) => {
      const elapsed = now - startTime;
      const progress = Math.min(1, elapsed / duration);
      // Ease-out cubic
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.round(oldRating + (newRating - oldRating) * eased);
      setDisplayRating(current);

      if (progress < 1) {
        requestAnimationFrame(frame);
      }
    };

    const timer = setTimeout(() => {
      requestAnimationFrame(frame);
    }, 350);

    return () => clearTimeout(timer);
  }, [open, oldRating, newRating]);

  return (
    <Dialog open={open} onOpenChange={(o) => !o && onClose()}>
      <DialogContent className="max-w-md bg-[#121417] border border-[#262a30] text-foreground p-0 overflow-hidden shadow-2xl rounded-2xl">
        {/* Banner */}
        <div className={`p-6 text-center border-b border-[#262a30] ${
          isWin ? "bg-emerald-950/30" : isLoss ? "bg-red-950/20" : "bg-neutral-900"
        }`}>
          <div className="w-16 h-16 rounded-full mx-auto mb-3 border-2 border-warning/40 overflow-hidden bg-card shadow-lg flex items-center justify-center">
            {userProfile.avatar ? (
              <img src={userProfile.avatar} alt={userProfile.name} className="w-full h-full object-cover" />
            ) : (
              <Trophy className="w-8 h-8 text-warning" />
            )}
          </div>
          <h2 className="text-xl font-black tracking-tight text-white">{userProfile.name}</h2>
          <div className="text-xs font-semibold tracking-wider uppercase mt-1">
            {isWin && <span className="text-emerald-400">VICTORY</span>}
            {isLoss && <span className="text-red-400">DEFEAT</span>}
            {!isWin && !isLoss && <span className="text-zinc-400">DRAW</span>}
            <span className="text-zinc-500 font-normal"> vs {opponentName}</span>
          </div>
        </div>

        {/* Animated Rating Centerpiece (matches reference image) */}
        <div className="p-6 space-y-6">
          <div className="bg-[#181b1f] border border-[#2a2e35] rounded-xl p-5 text-center">
            <div className="text-xs uppercase tracking-widest text-zinc-400 font-semibold mb-2">
              Private Glicko-2 Rating
            </div>
            <div className="flex items-center justify-center gap-3">
              <span className="text-4xl sm:text-5xl font-black text-white tracking-tight tabular-nums font-mono">
                {displayRating}
              </span>
              <span
                className={`text-xl sm:text-2xl font-bold font-mono px-2 py-0.5 rounded-md ${
                  delta > 0
                    ? "text-emerald-400 bg-emerald-500/10"
                    : delta < 0
                    ? "text-red-400 bg-red-500/10"
                    : "text-zinc-400 bg-zinc-800"
                }`}
              >
                {delta > 0 ? `+${delta}` : delta}
              </span>
            </div>

            {newRating >= userProfile.peakRating && newRating > oldRating && (
              <div className="mt-2.5 inline-flex items-center gap-1.5 text-xs text-warning bg-warning/10 px-2.5 py-1 rounded-full border border-warning/30 font-semibold animate-pulse">
                <Award className="w-3.5 h-3.5" /> All-Time Peak Rating!
              </div>
            )}
          </div>

          {/* Opponent Rating Summary */}
          <div className="flex items-center justify-between p-3.5 bg-[#181b1f]/60 rounded-lg border border-[#22252a] text-xs">
            <div className="flex items-center gap-2.5">
              <div className="w-7 h-7 rounded-full bg-zinc-800 overflow-hidden">
                {opponentAvatar ? (
                  <img src={opponentAvatar} alt={opponentName} className="w-full h-full object-cover" />

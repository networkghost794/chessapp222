export function PrivateBotPlayerArena() {
  const [bots, setBots] = useState<BotConfig[]>([]);
  const [profiles, setProfiles] = useState<Record<string, PrivateBotProfile>>({});
  const [loading, setLoading] = useState(true);

  const [activeTab, setActiveTab] = useState<"select" | "play" | "leaderboard" | "profile">("select");
  const [selectedBotId, setSelectedBotId] = useState<string | null>(null);
  const [opponentBotId, setOpponentBotId] = useState<string | null>(null);
  const [playerColor, setPlayerColor] = useState<Color>("w");

  // Game state
  const [game, setGame] = useState(() => new Chess());
  const [history, setHistory] = useState<string[]>([]);
  const [lastMove, setLastMove] = useState<{ from: Square; to: Square } | null>(null);
  const [engineThinking, setEngineThinking] = useState(false);

  // Result modal state
  const [modalOpen, setModalOpen] = useState(false);
  const [matchResult, setMatchResult] = useState<{
    result: "win" | "loss" | "draw";
    userOldRating: number;
    userNewRating: number;
    userDelta: number;
    oppOldRating: number;
    oppDelta: number;
  } | null>(null);

  useEffect(() => {
    (async () => {
      setLoading(true);
      const botList = await fetchBots();
      setBots(botList);
      const profs = await fetchPrivateBotProfiles(botList);
      setProfiles(profs);
      if (botList.length > 0) {
        setSelectedBotId(botList[0].id);
        if (botList.length > 1) setOpponentBotId(botList[1].id);
      }
      setLoading(false);
    })();
  }, []);

  const selectedBot = bots.find((b) => b.id === selectedBotId);
  const opponentBot = bots.find((b) => b.id === opponentBotId);
  const selectedProfile = selectedBotId ? profiles[selectedBotId] : null;

  const startMatch = () => {
    if (!selectedBot || !opponentBot) return;
    const newG = new Chess();
    setGame(newG);
    setHistory([]);
    setLastMove(null);
    setModalOpen(false);
    setActiveTab("play");

    // If human is Black, trigger engine's first move as White
    if (playerColor === "b") {
      triggerOpponentMove(newG, opponentBot);
    }
  };

  const triggerOpponentMove = async (g: Chess, opp: BotConfig) => {
    setEngineThinking(true);
    try {
      const picked = await chooseBotMove(g, opp);
      if (picked) {
        const moveRes = g.move({
          from: picked.move.from,
          to: picked.move.to,
          promotion: picked.move.promotion as any,
        });
        if (moveRes) {
          playMoveResultSound(moveRes);
          setHistory([...g.history()]);
          setLastMove({ from: moveRes.from, to: moveRes.to });
          setGame(new Chess(g.fen()));
          checkGameOver(g);
        }
      }
    } finally {
      setEngineThinking(false);
    }
  };

  const handleHumanMove = (from: Square, to: Square): boolean => {
    if (game.isGameOver() || engineThinking) return false;
    const isHumanTurn = game.turn() === playerColor;
    if (!isHumanTurn) return false;

    try {
      const moveRes = game.move({ from, to, promotion: "q" });
      if (!moveRes) return false;

      playMoveResultSound(moveRes);
      setHistory([...game.history()]);
      setLastMove({ from: moveRes.from, to: moveRes.to });
      setGame(new Chess(game.fen()));

      if (checkGameOver(game)) return true;

      // Opponent turn
      if (opponentBot) {
        setTimeout(() => triggerOpponentMove(game, opponentBot), 350);
      }
      return true;
    } catch {
      return false;
    }
  };

  const checkGameOver = (g: Chess): boolean => {
    if (!g.isGameOver()) return false;
    let res: "win" | "loss" | "draw" = "draw";
    if (g.isCheckmate()) {
      const winner = g.turn() === "w" ? "b" : "w";
      res = winner === playerColor ? "win" : "loss";
    }

    if (selectedBotId && opponentBotId) {
      const resultData = recordPrivateGame(
        profiles,
        selectedBotId,
        opponentBotId,
        playerColor,
        res,
        g.history().length,

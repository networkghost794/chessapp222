              <div>
                <label className="text-[11px] text-zinc-400 font-semibold block mb-1.5">Choose Opponent Engine</label>
                <Select value={opponentBotId ?? ""} onValueChange={(v) => setOpponentBotId(v)}>
                  <SelectTrigger className="bg-[#121417] border-[#2a2e35] text-xs h-9">
                    <SelectValue placeholder="Select opponent" />
                  </SelectTrigger>
                  <SelectContent className="bg-[#181b20] border-[#2a2e35] text-xs max-h-60">
                    {bots
                      .filter((b) => b.id !== selectedBotId)
                      .map((b) => (
                        <SelectItem key={b.id} value={b.id}>
                          {b.name} (Public: {b.rating} | Private: {profiles[b.id]?.currentRating ?? b.rating})
                        </SelectItem>
                      ))}
                  </SelectContent>
                </Select>
              </div>

              {/* Color Choice */}
              <div>
                <label className="text-[11px] text-zinc-400 font-semibold block mb-1.5">Playing Color</label>
                <div className="grid grid-cols-2 gap-2">
                  <Button
                    type="button"
                    size="sm"
                    variant={playerColor === "w" ? "default" : "outline"}
                    onClick={() => setPlayerColor("w")}
                    className={playerColor === "w" ? "bg-white text-black font-bold" : "border-[#2a2e35] text-zinc-400"}
                  >
                    ⚪ White (1st)
                  </Button>
                  <Button
                    type="button"
                    size="sm"
                    variant={playerColor === "b" ? "default" : "outline"}
                    onClick={() => setPlayerColor("b")}
                    className={playerColor === "b" ? "bg-zinc-800 text-white font-bold" : "border-[#2a2e35] text-zinc-400"}
                  >
                    ⚫ Black (2nd)
                  </Button>
                </div>
              </div>

              <Button
                onClick={startMatch}
                className="w-full bg-warning text-black hover:bg-warning/90 font-bold h-10 mt-2"
              >
                <Swords className="w-4 h-4 mr-2" /> Start Rated Match
              </Button>
            </Card>
          </div>
        </div>
      )}

      {/* Active Game View */}
      {activeTab === "play" && selectedBot && opponentBot && (
        <div className="max-w-[750px] mx-auto space-y-4">
          {/* Opponent Card (Top) */}
          <div className="flex items-center justify-between p-3 bg-[#181b20] border border-[#262a30] rounded-xl">
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded-full bg-zinc-800 overflow-hidden">
                <img src={opponentBot.avatar} alt="" className="w-full h-full object-cover" />
              </div>
              <div>
                <div className="text-sm font-bold text-white">{opponentBot.name}</div>
                <div className="text-xs text-zinc-400 font-mono">
                  Private: {profiles[opponentBot.id]?.currentRating ?? opponentBot.rating}
                </div>
              </div>
            </div>
            {engineThinking && (
              <Badge variant="outline" className="border-warning/50 text-warning animate-pulse text-xs">
                Thinking…
              </Badge>
            )}
          </div>

          {/* Chessboard */}
          <div className="flex justify-center">
            <Board
              game={game}
              flipped={playerColor === "b"}
              lastMove={lastMove}
              onMove={handleHumanMove}
            />
          </div>

          {/* Player Card (Bottom - Piloting selected bot) */}
          <div className="flex items-center justify-between p-3 bg-[#181b20] border border-warning/30 rounded-xl">
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded-full border-2 border-warning/60 overflow-hidden bg-card">
                <img src={selectedBot.avatar} alt="" className="w-full h-full object-cover" />
              </div>
              <div>
                <div className="text-sm font-bold text-white flex items-center gap-2">
                  {selectedBot.name}
                  <span className="text-[10px] text-warning bg-warning/10 px-1.5 py-0.5 rounded font-mono">YOU</span>
                </div>
                <div className="text-xs text-warning font-mono">
                  Private: {selectedProfile?.currentRating}
                </div>
              </div>
            </div>

            <Button
              size="sm"
              variant="outline"
              onClick={() => setActiveTab("select")}
              className="text-xs border-[#2a2e35] text-zinc-400"
            >
              Exit Match
            </Button>
          </div>
        </div>
      )}

      {/* Leaderboard View */}
      {activeTab === "leaderboard" && (
        <Card className="bg-[#181b20] border-[#262a30] p-6 space-y-4">
          <h2 className="text-base font-bold text-white flex items-center gap-2">
            <Trophy className="w-4 h-4 text-warning" /> Private Glicko-2 Leaderboard
          </h2>
          <div className="divide-y divide-[#262a30]">
            {Object.values(profiles)
              .sort((a, b) => b.currentRating - a.currentRating)
              .map((p, idx) => (
                <div key={p.botId} className="py-3 flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <span className="font-mono font-bold text-sm text-zinc-500 w-6">#{idx + 1}</span>
                    <div className="w-9 h-9 rounded-full bg-zinc-800 overflow-hidden">
                      <img src={p.avatar} alt="" className="w-full h-full object-cover" />
                    </div>
                    <div>
                      <div className="font-bold text-sm text-white">{p.name}</div>
                      <div className="text-[11px] text-zinc-400">
                        {p.gamesPlayed} games ({p.wins}W - {p.losses}L - {p.draws}D)
                      </div>
                    </div>
                  </div>
                  <div className="text-right">
                    <div className="font-mono font-bold text-base text-warning">{p.currentRating}</div>
                    <div className="text-[10px] text-zinc-500">Peak {p.peakRating} · RD {p.rd}</div>
                  </div>
                </div>
              ))}
          </div>
        </Card>
      )}

      {/* Post-Game Animated Modal */}
      {modalOpen && matchResult && selectedProfile && opponentBot && (
        <PrivateRatingModal
          open={modalOpen}
          onClose={() => setModalOpen(false)}
          result={matchResult.result}
          userProfile={selectedProfile}
          oldRating={matchResult.userOldRating}
          newRating={matchResult.userNewRating}
          delta={matchResult.userDelta}
          opponentName={opponentBot.name}
          opponentAvatar={opponentBot.avatar}
          opponentOldRating={matchResult.oppOldRating}
          opponentDelta={matchResult.oppDelta}
          onRematch={startMatch}
          onNewMatch={() => {
            setModalOpen(false);
            setActiveTab("select");
          }}
        />
      )}
    </div>
  );
}






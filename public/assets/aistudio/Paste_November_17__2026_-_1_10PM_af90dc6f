                src={reigning.avatarUrl || "/placeholder.svg"}
                alt={reigning.botName}
                className="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl object-cover ring-2 ring-amber-500 shadow-xl"
              />
              <div className="absolute -top-3 -right-3 w-8 h-8 rounded-full bg-amber-500 grid place-items-center text-black shadow-md">
                <Crown className="w-5 h-5 fill-black" />
              </div>
            </div>
            <div>
              <div className="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-400 text-[11px] font-bold tracking-wider uppercase border border-amber-500/30">
                Official World Champion
              </div>
              <h1 className="text-2xl sm:text-3xl font-black text-white mt-1">
                {reigning.botName}
              </h1>
              <p className="text-xs text-zinc-400">
                Rating: <span className="font-semibold text-white">{reigning.rating}</span> • Title
                Defenses:{" "}
                <span className="font-semibold text-amber-400">{reigning.defensesCount}</span> •
                Reign: Since {reigning.reignSince}
              </p>
            </div>
          </div>
          <div className="text-right sm:border-l sm:border-zinc-800 sm:pl-6 space-y-1">
            <div className="text-[11px] uppercase tracking-wider text-zinc-400 font-mono">
              Championship Status
            </div>
            <div className="text-sm font-bold text-amber-400 capitalize">
              {cycle ? `${cycle.stage} Stage Active` : "Next Cycle Upcoming"}
            </div>
          </div>
        </div>
      </div>

      {/* TABS */}
      <div className="flex gap-2 border-b border-zinc-800 pb-2">
        <button
          onClick={() => setActiveTab("live")}
          className={`flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold transition-all ${
            activeTab === "live"
              ? "bg-amber-500 text-black shadow-lg shadow-amber-500/20"
              : "text-zinc-400 hover:text-white hover:bg-zinc-800/50"
          }`}
        >
          <PlaySquare className="w-4 h-4" /> Live Title Match
        </button>
        <button
          onClick={() => setActiveTab("candidates")}
          className={`flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold transition-all ${
            activeTab === "candidates"
              ? "bg-amber-500 text-black shadow-lg shadow-amber-500/20"
              : "text-zinc-400 hover:text-white hover:bg-zinc-800/50"
          }`}
        >
          <Trophy className="w-4 h-4" /> Candidates Tournament
        </button>
        <button
          onClick={() => setActiveTab("hall")}
          className={`flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold transition-all ${
            activeTab === "hall"
              ? "bg-amber-500 text-black shadow-lg shadow-amber-500/20"
              : "text-zinc-400 hover:text-white hover:bg-zinc-800/50"
          }`}
        >
          <History className="w-4 h-4" /> Hall of Champions
        </button>
      </div>

      {/* TAB CONTENT: LIVE MATCH */}
      {activeTab === "live" && (
        <Card className="p-6 bg-[#16181c] border-zinc-800 space-y-6">
          {!cycle || cycle.stage !== "match" ? (
            <div className="text-center py-12 space-y-2 text-zinc-400">
              <Trophy className="w-10 h-10 mx-auto text-zinc-600 mb-2" />
              <div className="font-bold text-white">No Title Match Currently Active</div>
              <p className="text-xs">
                The Candidates tournament must conclude before the World Championship match begins.
              </p>
            </div>
          ) : (
            <div className="space-y-6">
              {/* Match Header Score */}
              <div className="flex items-center justify-around p-6 rounded-xl bg-black/40 border border-zinc-800">
                <div className="text-center space-y-2">
                  <div className="text-xs uppercase font-mono text-amber-500 font-bold">
                    Reigning Champion
                  </div>
                  <div className="text-xl font-black text-white">
                    {bots.find((b) => b.id === cycle.match.championId)?.name || "Champion"}
                  </div>
                  <div className="text-4xl font-black text-amber-400">
                    {cycle.match.championScore}
                  </div>
                </div>
                <div className="text-center">
                  <div className="text-xs text-zinc-500 uppercase font-mono">Game 1 of 14</div>
                  <div className="text-2xl font-bold text-zinc-600 font-mono">VS</div>
                  <div className="text-xs text-zinc-500">First to 7.5 wins</div>
                </div>
                <div className="text-center space-y-2">
                  <div className="text-xs uppercase font-mono text-blue-400 font-bold">
                    Candidates Challenger
                  </div>
                  <div className="text-xl font-black text-white">
                    {bots.find((b) => b.id === cycle.match.challengerId)?.name || "Challenger"}
                  </div>
                  <div className="text-4xl font-black text-blue-400">
                    {cycle.match.challengerScore}
                  </div>
                </div>
              </div>
            </div>
          )}
        </Card>
      )}

      {/* TAB CONTENT: CANDIDATES STANDINGS */}
      {activeTab === "candidates" && (
        <Card className="p-6 bg-[#16181c] border-zinc-800">
          <h3 className="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <Trophy className="w-5 h-5 text-amber-500" /> Official Candidates Leaderboard
          </h3>
          <div className="overflow-x-auto">
            <table className="w-full text-xs text-left">
              <thead className="bg-zinc-900/60 text-zinc-400 uppercase font-mono border-b border-zinc-800">
                <tr>
                  <th className="p-3">#</th>
                  <th className="p-3">Bot</th>
                  <th className="p-3">Rating</th>
                  <th className="p-3 text-center">Played</th>
                  <th className="p-3 text-center">W</th>
                  <th className="p-3 text-center">D</th>
                  <th className="p-3 text-center">L</th>
                  <th className="p-3 text-right">Points</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-zinc-800/50">
                {(cycle?.candidates.standings || []).map((s, idx) => (
                  <tr
                    key={s.botId}
                    className={idx === 0 ? "bg-amber-500/10 font-bold text-amber-400" : ""}
                  >
                    <td className="p-3">{idx + 1}</td>
                    <td className="p-3 flex items-center gap-2">
                      <img
                        src={s.avatarUrl}
                        alt=""
                        className="w-5 h-5 rounded-full object-cover"
                      />
                      <span>{s.botName}</span>
                      {idx === 0 && <Crown className="w-3.5 h-3.5 text-amber-400" />}
                    </td>
                    <td className="p-3 text-zinc-400 font-mono">{s.rating}</td>
                    <td className="p-3 text-center">{s.played}</td>
                    <td className="p-3 text-center text-emerald-400">{s.wins}</td>
                    <td className="p-3 text-center text-zinc-400">{s.draws}</td>
                    <td className="p-3 text-center text-rose-400">{s.losses}</td>
                    <td className="p-3 text-right font-bold text-sm">{s.points}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Card>
      )}

      {/* TAB CONTENT: HALL OF CHAMPIONS */}
      {activeTab === "hall" && (
        <div className="space-y-4">
          {hall.length === 0 ? (
            <div className="p-12 text-center text-zinc-500 text-xs">
              No previous championship records archived yet.
            </div>
          ) : (
            hall.map((record, i) => (
              <Card
                key={i}
                className="p-5 bg-[#16181c] border-zinc-800 flex items-center justify-between"
              >
                <div className="flex items-center gap-4">
                  <div className="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 grid place-items-center text-amber-500">
                    <Crown className="w-6 h-6" />
                  </div>
                  <div>
                    <div className="text-[11px] font-mono text-zinc-500 uppercase">
                      {record.year} • {record.cycleName}
                    </div>
                    <div className="text-base font-bold text-white flex items-center gap-2">
                      {record.championName}{" "}
                      <span className="text-xs font-normal text-zinc-400">def.</span>{" "}
                      {record.challengerName}
                    </div>
                    <div className="text-xs text-zinc-400">
                      Concluded: {record.dateConcluded} • {record.gamesPlayed} Games Played
                    </div>
                  </div>
                </div>
                <div className="text-right">
                  <div className="text-xs font-mono text-zinc-500">Score</div>
                  <div className="text-lg font-black text-amber-400">{record.finalScore}</div>
                </div>
              </Card>
            ))
          )}
        </div>
      )}
    </div>
  );
}





